  <script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.lightbox-video').forEach(async function (lightbox) {
      const img = lightbox.querySelector('.video-thumbnail');
      const json = lightbox.querySelector('.w-json');
      if (!img || !json) return;
      const currentSrc = img.getAttribute('src') || '';
      const isEmpty = currentSrc.trim() === '';
      const isPlaceholder = currentSrc.includes('/plugins/Basic/assets/placeholder');
      if (!isEmpty && !isPlaceholder) return;
      try {
        const data = JSON.parse(json.textContent);
        const videoUrl = data.items?.[0]?.url;
        if (!videoUrl) return;
        const response = await fetch('https://vimeo.com/api/oembed.json?url=' + encodeURIComponent(videoUrl));
        const vimeoData = await response.json();
        if (vimeoData.thumbnail_url) {
          img.src = vimeoData.thumbnail_url.replace(/_\d+x\d+/, '_1280x720');
          img.removeAttribute('srcset');
          img.removeAttribute('sizes');
          img.style.setProperty('display', 'block', 'important');
        }
      } catch (error) {
        console.log('Vimeo thumbnail error:', error);
      }
    });
    document.querySelectorAll('.highlighted-videos').forEach(function (section) {
      const hasEmptyVideo = section.querySelector('.lightbox-video.w-dyn-bind-empty');
      if (hasEmptyVideo) {
        section.querySelectorAll('.lightbox-video:not(.w-dyn-bind-empty)').forEach(function (video) {
          const parentCol = video.closest('._6-col');
          if (parentCol) {
            parentCol.classList.remove('_6-col');
            parentCol.classList.add('_12-col');
          }
        });
      }
    });
    /* Images Slider START */
    const imagesSliderEl = document.querySelector('#images-slider');
    if (imagesSliderEl) {
      const imagesSlider = new Splide('#images-slider', {
        type: 'loop',
        drag: 'free',
        focus: 'center',
         height   : '16.875rem',
        arrows: false,
        pagination: false,
        gap: '0.875rem',
        autoWidth: true,
        perPage: 3,
        autoScroll: {
          speed: 0.5,
          pauseOnFocus: false,
          pauseOnHover: false,
        },
        breakpoints: {
          992: {
            perPage: 2,
          },
          767: {
            perPage: 1,
          },
        },
      });
      imagesSlider.mount(window.splide.Extensions);
    }
    /* Images Slider END */
    /* Videos Second Section START */
    const videoGallery = document.querySelector('.video-gallery');
    if (!videoGallery) return;
    const allVideos = Array.from(videoGallery.querySelectorAll('.lightbox-video'));
    const activeVideos = allVideos.filter(function (video) {
      return !video.classList.contains('w-dyn-bind-empty');
    });
    if (activeVideos.length === 1) {
      const parentCol = activeVideos[0].closest('._6-col');
      if (parentCol) {
        parentCol.classList.remove('_6-col');
        parentCol.classList.add('_12-col');
      }
      return;
    }
    if (activeVideos.length === 2) {
      return;
    }
    if (activeVideos.length >= 3) {
      videoGallery.querySelectorAll('.lightbox-video.w-dyn-bind-empty').forEach(function (emptyVideo) {
        const emptyCol = emptyVideo.closest('._6-col');
        if (emptyCol) emptyCol.remove();
      });
      activeVideos.forEach(function (video) {
        const slide = video.closest('._6-col');
        if (slide) {
          slide.className = '';
          slide.classList.add('splide__slide');
        }
      });
      const firstSlide = videoGallery.querySelector('.splide__slide');
      if (!firstSlide) return;
      const list = firstSlide.parentElement;
      const track = list.parentElement;
      const slider = track.parentElement;
      list.className = 'splide__list';
      track.className = 'splide__track';
      slider.className = 'splide';
      slider.id = 'video-slider';
      const videoSlider = new Splide('#video-slider', {
        arrowPath: 'M33.5488 18.7969C34.3537 19.3967 34.3537 20.6033 33.5488 21.2031L15.6465 34.5391C14.6571 35.2761 13.2502 34.5706 13.25 33.3369L13.25 6.66309C13.2502 5.42944 14.6571 4.72389 15.6465 5.46094L33.5488 18.7969Z',
        classes: {
          arrows: 'splide__arrows c_slider-arrows',
          arrow: 'splide__arrow c_slider-arrow',
        },
        pagination: false,
        gap: '5rem',
        perPage: 2,
        breakpoints: {
          1200: {
            gap: '3rem',
          },
          992: {
            perPage: 1,
          },
        },
      });
      videoSlider.mount();
    }
    /* Videos Second Section END */
  });
</script>
</body>
</html>