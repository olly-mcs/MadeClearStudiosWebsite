---js
// One page per published case study (src/_data/caseStudies.json), at /case-study/<slug>
const pagination = { data: "caseStudies", size: 1, alias: "cs", before: (items) => items.filter((i) => !i.draft && !i.archived) };
const permalink = (data) => `case-study/${data.cs.slug}.html`;
const eleventyExcludeFromCollections = true;
