{#- Top navigation. The Services dropdown lists the Service Categories (src/_data/serviceCategories.json).
    Clicking one jumps to that section of /services (see the "Navlink Services Click" script on each page). -#}
{%- macro current(url) %}{% if page.url | replace(".html", "") == url %} aria-current="page"{% endif %}{% endmacro -%}
{%- macro currentClass(url) %}{% if page.url | replace(".html", "") == url %} w--current{% endif %}{% endmacro -%}
    <div data-animation="default" class="section bg-transparent t_flex t_align-center w-nav" data-easing2="ease" data-easing="ease" data-collapse="medium" data-w-id="49f5e56c-8521-8763-403a-7fb5a593df04" role="banner" data-no-scroll="1" data-duration="400" data-doc-height="1">
      <div class="container t_flex t_align-center t_justify-space-between">
        <div class="none t_block">
          <a href="/"{{ current("/") }} class="width-7-875 padding-0 w-nav-brand{{ currentClass("/") }}"><img loading="eager" src="/images/MClogo.avif" alt="" class="width-100-pct"></a>
        </div>
        <nav role="navigation" class="padding-vertical width-100-pct padding-1-25 c_mob-menu w-nav-menu">
          <div class="width-100-pct flex vertical">
            <div class="none">
              <div class="grid _7-col width-100-pct justify-center align-center t_flex t_vertical">
                <div class="flex align-center justify-center">
                  <a href="/about"{{ current("/about") }} class="navlink{{ currentClass("/about") }}">About</a>
                </div>
                <div class="flex align-center justify-center t_vertical">
                  <div data-hover="true" data-delay="0" class="t_flex t_vertical t_align-center w-dropdown">
                    <div class="padding-0 w-dropdown-toggle">
                      <a href="/services" class="navlink service-main">Services</a>
                      <div class="navlink services-mobile">Services</div>
                    </div>
                    <nav class="dropdown-nav w-dropdown-list">
                      <div class="w-dyn-list">
                        <div role="list" class="w-dyn-items">
                          {%- for cat in serviceCategories | published %}
                          <div role="listitem" class="w-dyn-item">
                            <a href="/services" class="navlink service-link w-dropdown-link">{{ cat.name }}</a>
                          </div>
                          {%- endfor %}
                        </div>
                      </div>
                    </nav>
                  </div>
                </div>
                <div class="flex align-center justify-center">
                  <a href="/case-studies"{{ current("/case-studies") }} class="navlink{{ currentClass("/case-studies") }}">Case Studies</a>
                </div>
                <div class="padding-0"></div>
                <div class="flex align-center justify-center">
                  <a href="/kol"{{ current("/kol") }} class="navlink{{ currentClass("/kol") }}">KOL Hub</a>
                </div>
                <div class="flex align-center justify-center">
                  <a href="/insights"{{ current("/insights") }} class="navlink{{ currentClass("/insights") }}">Insights</a>
                </div>
                <div class="flex align-center justify-center">
                  <a href="/contact"{{ current("/contact") }} class="navlink{{ currentClass("/contact") }}">Contact</a>
                </div>
              </div>
            </div>
            <div class="flex justify-space-between t_vertical align-center">
              <div class="flex justify-space-between width-100-pct t_vertical">
                <div class="flex align-center justify-center">
                  <a href="/about"{{ current("/about") }} class="navlink{{ currentClass("/about") }}">About</a>
                </div>
                <div class="flex align-center justify-center t_vertical">
                  <div data-hover="true" data-delay="0" class="t_flex t_vertical t_align-center w-dropdown">
                    <div class="padding-0 w-dropdown-toggle">
                      <a href="/services" class="navlink service-main">Services</a>
                      <div class="navlink services-mobile">Services</div>
                    </div>
                    <nav class="dropdown-nav w-dropdown-list">
                      <div class="w-dyn-list">
                        <div role="list" class="w-dyn-items">
                          {%- for cat in serviceCategories | published %}
                          <div role="listitem" class="w-dyn-item">
                            <a href="/services" class="navlink service-link w-dropdown-link">{{ cat.name }}</a>
                          </div>
                          {%- endfor %}
                        </div>
                      </div>
                    </nav>
                  </div>
                </div>
                <div class="flex align-center justify-center">
                  <a href="/case-studies"{{ current("/case-studies") }} class="navlink{{ currentClass("/case-studies") }}">Case Studies</a>
                </div>
              </div>
              <a href="/"{{ current("/") }} class="nav-logo-link t_none w-nav-brand{{ currentClass("/") }}"><img loading="eager" src="/images/MClogo.avif" alt="" class="width-100-pct"></a>
              <div class="flex justify-space-between width-100-pct t_vertical">
                <div class="flex align-center justify-center">
                  <a href="/kol-list"{{ current("/kol-list") }} class="navlink{{ currentClass("/kol-list") }}">KOL Hub</a>
                </div>
                <div class="flex align-center justify-center">
                  <a href="/insights"{{ current("/insights") }} class="navlink{{ currentClass("/insights") }}">Insights</a>
                </div>
                <div class="flex align-center justify-center">
                  <a href="/contact"{{ current("/contact") }} class="navlink{{ currentClass("/contact") }}">Contact</a>
                </div>
              </div>
            </div>
          </div>
        </nav>
        <div class="menu-btn w-nav-button">
          <div class="nav-burger_line first"></div>
          <div class="nav-burger_line second"></div>
          <div class="nav-burger_line third"></div>
        </div>
      </div>
      <div class="divider absolute bottom-0 left-0"></div>
      {%- if navDivider %}
      <div class="divider-dark absolute bottom-0 left-0"></div>
      {%- endif %}
    </div>
