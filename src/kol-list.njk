  <script src="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/js/splide.min.js"></script>
  <script>
  $(document).ready(function () {
    /* Testimonials Slider START */
    const singleTestimonialsSliderParent = document.querySelector('#client-single-testimonial-slider');
    if (singleTestimonialsSliderParent) {
      const items = singleTestimonialsSliderParent.querySelectorAll('.testimonial-item');
      if (items.length > 1) {
        singleTestimonialsSliderParent.className = 'splide';
        const track = singleTestimonialsSliderParent.children[0];
        const list = track && track.children[0];
        if (track && list) {
          track.className = 'splide__track';
          list.className = 'splide__list';
          items.forEach((item) => {
            item.className = 'splide__slide';
          });
          const singleTestimonialsSlider = new Splide('#client-single-testimonial-slider', {
            type: 'fade',
            arrowPath: 'M33.5488 18.7969C34.3537 19.3967 34.3537 20.6033 33.5488 21.2031L15.6465 34.5391C14.6571 35.2761 13.2502 34.5706 13.25 33.3369L13.25 6.66309C13.2502 5.42944 14.6571 4.72389 15.6465 5.46094L33.5488 18.7969Z',
            classes: {
              arrows: 'splide__arrows c_slider-arrows',
              arrow: 'splide__arrow c_slider-arrow',
            },
            pagination: false,
            perPage: 1,
          });
          singleTestimonialsSlider.mount();
        }
      }
    }
    /* Testimonials Slider END */
    const $clientList = $('.c_client-list');
    $('.c_client-item').each(function () {
      const $clientItem = $(this);
      const expertCount = $clientItem.find('.c_expert-item').length || parseInt($clientItem.find('.experts-count').first().text(), 10) || 0;
      const $countText = $clientItem.find('.experts-count').first();
      const $countWrapper = $clientItem.find('.c_expert-coun-wrapper').first();
      const $kolText = $clientItem.find('.c_kol-text').first();
      if (expertCount > 0) {
        $countText.text(expertCount);
        $kolText.text(expertCount === 1 ? 'KOL' : 'KOLs');
        $countWrapper.show();
      } else {
        $countWrapper.hide();
      }
    });
    const $caseStudies = $('.case-studies-list .case-study-item');
    $('.c_client-list .c_client-item').each(function () {
      const $clientItem = $(this);
      const clientNameText = $.trim($clientItem.find('.client-main-name').first().text());
      const clientName = clientNameText.toLowerCase();
      if (!clientNameText) return;
      $clientItem.find('.filter-letter p').first().text(clientNameText.charAt(0).toUpperCase());
      let $latestCaseStudy = null;
      let latestDate = null;
      $caseStudies.each(function () {
        const $caseStudy = $(this);
        const caseClientName = $.trim($caseStudy.find('.client-name').first().text()).toLowerCase();
        if (caseClientName !== clientName) return;
        const dateText = $.trim($caseStudy.find('.publish-date').first().text());
        const publishDate = new Date(dateText);
        if (!$latestCaseStudy || publishDate > latestDate) {
          $latestCaseStudy = $caseStudy;
          latestDate = publishDate;
        }
      });
      if ($latestCaseStudy && $latestCaseStudy.length) {
        $latestCaseStudy.find('.publish-date, .client-name').remove();
        $clientItem.find('.case-study-wrapper').first().append($latestCaseStudy);
      }
    });
    $('.case-studies-list-wrapper').remove();
    /* FILTER LETTER DISABLE START */
    $('.c_filter-checkbox').each(function () {
      const $checkbox = $(this);
      const letter = $.trim($checkbox.find('.filter-checkbox-letter').text()).toLowerCase();
      const exists =
        $('.filter-letter p').filter(function () {
          return $.trim($(this).text()).toLowerCase() === letter;
        }).length > 0;
      if (!exists) {
        $checkbox.addClass('filter-disable');
      }
    });
    /* FILTER LETTER DISABLE END */
    /* Experts Slider START */
    document.querySelectorAll('.experts-slider').forEach((expertsSliderParent, index) => {
      const items = expertsSliderParent.querySelectorAll('.c_expert-item');
      if (!items.length) {
        expertsSliderParent.style.display = 'none';
        return;
      }
      if (items.length > 3) {
        expertsSliderParent.id = `experts-slider-${index}`;
        expertsSliderParent.className = '';
        expertsSliderParent.classList.add('splide', 'padding-horizontal', 'padding-4', 'm_padding-2');
        const track = expertsSliderParent.querySelector('.w-dyn-list');
        const list = expertsSliderParent.querySelector('.w-dyn-items');
        if (track && list) {
          track.className = '';
          track.classList.add('splide__track');
          list.className = '';
          list.classList.add('splide__list');
          items.forEach((item) => {
            item.className = '';
            item.classList.add('splide__slide');
          });
          const expertsSlider = new Splide(`#experts-slider-${index}`, {
            arrowPath: 'M33.5488 18.7969C34.3537 19.3967 34.3537 20.6033 33.5488 21.2031L15.6465 34.5391C14.6571 35.2761 13.2502 34.5706 13.25 33.3369L13.25 6.66309C13.2502 5.42944 14.6571 4.72389 15.6465 5.46094L33.5488 18.7969Z',
            classes: {
              arrows: 'splide__arrows width-100-pct',
              arrow: 'splide__arrow c_slider-arrow',
            },
            pagination: false,
            gap: '0.875rem',
            perPage: 3,
            breakpoints: {
              992: {
                perPage: 2,
              },
              767: {
                perPage: 1,
              },
            },
          });
          expertsSlider.mount();
        }
      }
    });
    /* Experts Slider END */
    /* CLIENT BOTTOM ACCORDION START */
    if ($clientList.length) {
      function closeClient($item) {
        const $bottom = $item.find('.client-item-bottom').first();
        const bottomHeight = $bottom.outerHeight();
        $item.removeClass('is-open');
        $bottom.css('margin-top', -bottomHeight + 'px');
      }
      function openClient($item) {
        const $bottom = $item.find('.client-item-bottom').first();
        $item.addClass('is-open');
        $bottom.css('margin-top', '0px');
      }
      function recalculateClosedClients() {
        $clientList.find('.c_client-item').each(function () {
          const $item = $(this);
          if (!$item.hasClass('is-open')) {
            closeClient($item);
          }
        });
      }
      function setInitialClientState() {
        $clientList.find('.c_client-item').each(function () {
          closeClient($(this));
        });
        setTimeout(function () {
          $clientList.addClass('is-ready');
        }, 50);
        setTimeout(function () {
          recalculateClosedClients();
          $('.client-item-bottom').removeClass('c_kol-negative-margin');
        }, 1500);
      }
      setInitialClientState();
      $clientList.find('.c_client-accordion').on('click', function () {
        const $item = $(this).closest('.c_client-item');
        if ($item.hasClass('is-open')) {
          closeClient($item);
        } else {
          openClient($item);
        }
      });
      $(window).on('resize', function () {
        recalculateClosedClients();
        setTimeout(function () {
          recalculateClosedClients();
        }, 1000);
      });
    }
    /* CLIENT BOTTOM ACCORDION END */
  });
</script>
