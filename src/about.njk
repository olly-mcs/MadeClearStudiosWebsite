https://cdn.jsdelivr.net/npm/gsap@3.15/dist/gsap.min.js
"></script>
  <script src="
https://cdn.jsdelivr.net/npm/gsap@3.15/dist/ScrollTrigger.min.js
"></script>
  <script src="https://unpkg.com/split-type"></script>
  <script>
  $(document).ready(function () {
    gsap.registerPlugin(ScrollTrigger);
    let split;
    let windowWidth = window.innerWidth;
    function debounce(func, delay) {
      let timeout;
      return function () {
        clearTimeout(timeout);
        timeout = setTimeout(function () {
          func();
        }, delay);
      };
    }
    function getScrollSettings() {
      if (window.innerWidth <= 767) {
        return {
          start: 'top 150px',
          end: 'center 60%',
        };
      }
      if (window.innerWidth <= 991) {
        return {
          start: 'top 153px',
          end: 'center 55%',
        };
      }
      return {
        start: 'top 170px',
        end: 'center 50%',
      };
    }
    function runSplit() {
      if (split) split.revert();
      ScrollTrigger.getAll().forEach(function (trigger) {
        trigger.kill();
      });
      split = new SplitType('.split-lines, .split-lines-dark, .split-lines-grey', {
        types: 'lines, words',
      });
      $('.line').each(function () {
        const $line = $(this);
        const settings = getScrollSettings();
        $line.find('.line-mask').remove();
        $line.append('<div class="line-mask"></div>');
        gsap.fromTo(
          $line.find('.line-mask'),
          { width: '100%' },
          {
            width: '0%',
            ease: 'none',
            scrollTrigger: {
              trigger: this,
              start: settings.start,
              end: settings.end,
              scrub: 1,
            },
          },
        );
      });
      ScrollTrigger.refresh();
      $('.text-color-fade').css('color', 'var(--text-color--text-primary)');
    }
    runSplit();
    window.addEventListener(
      'resize',
      debounce(function () {
        if (windowWidth !== window.innerWidth) {
          windowWidth = window.innerWidth;
          runSplit();
        }
      }, 250),
    );
    /* FAQ START */
    const $faqList = $('.faq-list');
    if ($faqList.length) {
      function closeFaq($item) {
        const $content = $item.find('.faq-content').first();
        const contentHeight = $content.outerHeight();
        $item.removeClass('is-open');
        $content.css('margin-top', -contentHeight + 'px');
      }
      function openFaq($item) {
        const $content = $item.find('.faq-content').first();
        $item.addClass('is-open');
        $content.css('margin-top', '0px');
      }
      function setInitialFaqState() {
        $faqList.find('.faq-item').each(function () {
          closeFaq($(this));
        });
        setTimeout(function () {
          $faqList.addClass('is-ready');
        }, 50);
      }
      setInitialFaqState();
      $faqList.find('.faq-item').on('click', function () {
        const $item = $(this);
        if ($item.hasClass('is-open')) {
          closeFaq($item);
        } else {
          openFaq($item);
          $item.siblings('.faq-item').each(function () {
            closeFaq($(this));
          });
        }
      });
      $(window).on('resize', function () {
        $faqList.find('.faq-item').each(function () {
          const $item = $(this);
          if (!$item.hasClass('is-open')) {
            closeFaq($item);
          }
        });
      });
    }
    /* FAQ END */
  });
</script>
</body>
</html>