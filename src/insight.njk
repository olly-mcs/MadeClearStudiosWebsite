---js
// One page per published insight (src/_data/insights.json), at /insights/<slug>
const pagination = { data: "insights", size: 1, alias: "insight", before: (items) => items.filter((i) => !i.draft && !i.archived) };
const permalink = (data) => `insights/${data.insight.slug}.html`;
const eleventyExcludeFromCollections = true;
---
<!DOCTYPE html><!--  This site was created in Webflow. https://webflow.com  --><!--  Last Published: Wed Sep 30 2026 07:57:44 GMT+0000 (Coordinated Universal Time)  -->
<html data-wf-page="69ebb58dc9c36defb61a0a81" data-wf-site="69d7a9d5d387ff8d4be61f60" lang="en">
<head>
  <meta charset="utf-8">
  <title>{{ insight.title }}</title>
  <meta content="{{ insight.overview }}" name="description">
  <meta content="{{ insight.title }}" property="og:title">
  <meta content="{{ insight.overview }}" property="og:description">
  <meta content="{{ insight.coverPhoto }}" property="og:image">
  <meta content="{{ insight.title }}" name="twitter:title">
  <meta content="{{ insight.overview }}" name="twitter:description">
  <meta content="{{ insight.coverPhoto }}" name="twitter:image">
  <meta property="og:type" content="website">
  <meta content="summary_large_image" name="twitter:card">
  <meta content="width=device-width, initial-scale=1" name="viewport">
  <meta content="Webflow" name="generator">
  <link href="/css/normalize.css" rel="stylesheet" type="text/css">
  <link href="/css/webflow.css" rel="stylesheet" type="text/css">
  <link href="/css/made-clear-wip.webflow.css" rel="stylesheet" type="text/css">
  <link href="/css/site.css" rel="stylesheet" type="text/css">
  <script type="text/javascript">!function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);</script>
  <link href="/images/favicon.png" rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: light)">
  <link href="/images/favicon-dark.png" rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: dark)">
  <link href="/images/webclip.png" rel="apple-touch-icon"><!--  Google tag (gtag.js)  -->
  <script async="" src="https://www.googletagmanager.com/gtag/js?id=G-F6SX5N28QT"></script>
  <script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-F6SX5N28QT');
</script>
