https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/css/splide.min.css
" rel="stylesheet">
  <!--  Finsweet Attributes  -->
  <script async="" type="module" src="https://cdn.jsdelivr.net/npm/@finsweet/attributes@2/attributes.js" fs-smartlightbox=""></script>
</head>
<body>
  <div class="page-wrapper">
    {% include "global-styles.njk" %}
    <div class="page-embed w-embed">
      <style>
  @media screen and (min-width: 992px) and (max-width: 1200px) {
    .water-bubble.the-second {
      width: 8rem;
      height: 8rem;
      position: absolute;
      top: 172px;
      left: -419px;
    }
    .water-bubble.the-fifth {
      top: 119px;
      left: 382px;
    }
    .water-bubble.the-fourth {
      right: -400px;
    }
    .water-bubble.the-first {
      left: -400px;
    }
    .water-bubble.the-third {
      top: 274px;
      left: 238px;
    }
    .padding-horizontal.padding-5 {
      padding-right: 2rem;
      padding-left: 2rem;
    }
    .gap-5 {
      gap: 3rem;
    }
  }
</style>
    </div>
    {% include "nav.njk" %}
    <section class="section">
      <div class="section-padding-negative relative">{% if insight.coverPhoto %}<img src="{{ insight.coverPhoto }}" loading="lazy" alt="" class="width-100-pct _16x9">{% endif %}
        <div class="overlay-wrapper _16x9"></div>
      </div>
    </section>
    <main class="main">
      <article class="section padding-5">
        <div class="container-small">
          <div class="height-2 t_none"></div>
          <div class="relative">
            <div class="height-1-5 none t_block"></div>
            <div class="flex justify-space-between align-end t_vertical t_align-start">
              <div class="flex vertical gap-1">
                <div class="max-w-450">
                  <div class="relative">
                    <div class="c_our-experts-p-wrapper">
                      <h1 class="relative{{ ' w-dyn-bind-empty' if not insight.title }}">{{ insight.title }}</h1><img loading="lazy" src="/images/Vector-7.svg" alt="" class="vector-bg full-height">
                    </div>
                  </div>
                </div>
                <div class="max-w-440">
                  <p class="{{ ' w-dyn-bind-empty' if not insight.overview }}">{{ insight.overview }}</p>
                </div>
              </div>
            </div>
            <div class="height-5 t_height-2"></div>
            <div class="height-2"></div>
          </div>
        </div>
      </article>
      <section class="section padding-5">
        <div class="container-small">
          <div class="text-rich-text w-richtext">{{ insight.body | safe }}</div>
        </div>
      </section>
      {%- if insight.imageSlider.length %}
      <section class="section padding-5 overflow-hidden">
        <div id="images-slider" class="splide">
          <div class="splide__track">
            <ul class="splide__list">
              {%- for img in insight.imageSlider %}
              <li class="splide__slide c_image-slider-item"><img src="{{ img }}" loading="lazy" alt="" class="c_image-slider"></li>
              {%- endfor %}
            </ul>
          </div>
        </div>
      </section>
      {%- else %}
      <div id="images-slider" class="splide" style="display: none"><div class="splide__track"><ul class="splide__list"></ul></div></div>
      {%- endif %}
      <div class="border-1 bg-cream">
        <div class="form-wrapper">
          {% include "enquiry-form.njk" %}
          <div class="divider-dark"></div>
        </div>
        {% include "footer.njk" %}
      </div>
    </main>
  </div>
  <script src="/js/jquery-3.5.1.min.js" type="text/javascript"></script>
  <script src="/js/webflow.js" type="text/javascript"></script>
  <script src="/js/contact-form.js" type="text/javascript"></script>
  <script>
  document.addEventListener('DOMContentLoaded', () => {
    /* Navlink Services Click START */
    document.querySelectorAll('.service-link').forEach(function (link) {
      link.addEventListener('click', function (e) {
        e.preventDefault();
        const text = link.textContent.trim();
        const id = text.toLowerCase().replace(/\s+/g, '-');
        const href = link.getAttribute('href');
        const url = new URL(href, window.location.origin);
        url.hash = id;
        window.location.href = url.toString();
      });
    });
    /* Navlink Services Click END */
    /* Testimonials Slider START */
    const testimonialsSliderParent = document.querySelector('#testimonial-slider');
    if (testimonialsSliderParent) {
      const items = testimonialsSliderParent.querySelectorAll('.testimonial-item');
      if (items.length > 2) {
        testimonialsSliderParent.className = 'splide';
        const track = testimonialsSliderParent.children[0];
        const list = track && track.children[0];
        if (track && list) {
          track.className = 'splide__track';
          list.className = 'splide__list';
          items.forEach((item) => {
            item.className = 'splide__slide';
          });
          const testimonialsSlider = new Splide('#testimonial-slider', {
            arrowPath:
            'M33.5488 18.7969C34.3537 19.3967 34.3537 20.6033 33.5488 21.2031L15.6465 34.5391C14.6571 35.2761 13.2502 34.5706 13.25 33.3369L13.25 6.66309C13.2502 5.42944 14.6571 4.72389 15.6465 5.46094L33.5488 18.7969Z',
            classes: {
              arrows: 'splide__arrows c_slider-arrows',
              arrow: 'splide__arrow c_slider-arrow',
            },
            pagination: false,
            gap: '6rem',
            perPage: 2,
            breakpoints: {
              992: {
                perPage: 1,
              },
            },
          });
          testimonialsSlider.mount();
        }
      }
    }
    /* Testimonials Slider END */
    /* Do not add anything below this code */
    const canvases = document.querySelectorAll('.water-bubble');
    if (canvases.length) {
      const imageUrls = {
        'bubble-img-1': 'https://cdn.prod.website-files.com/69d7a9d5d387ff8d4be61f60/69dce65c7c01004820066763_hi%20res%20blob.avif',
        'bubble-img-2': 'https://cdn.prod.website-files.com/69d7a9d5d387ff8d4be61f60/6a059765cccbeea156bde1d2_blob%202.avif',
        'bubble-img-3': 'https://cdn.prod.website-files.com/69d7a9d5d387ff8d4be61f60/6a059765bb71a895e802fd7b_blob%203.avif',
        'bubble-img-4': 'https://cdn.prod.website-files.com/69d7a9d5d387ff8d4be61f60/6a05976502ec2a1b90a4195c_blob%204.avif',
        'bubble-img-5': 'https://cdn.prod.website-files.com/69d7a9d5d387ff8d4be61f60/6a059765cf706bfa1d20de94_blob%205.avif',
        'bubble-img-6': 'https://cdn.prod.website-files.com/69d7a9d5d387ff8d4be61f60/6a05976536cc83c2cccefd95_blob%206.avif',
      };
      function getImageUrl(canvasEl) {
        for (const className in imageUrls) {
          if (canvasEl.classList.contains(className)) {
            return imageUrls[className];
          }
        }
        return imageUrls['bubble-img-1'];
      }
      canvases.forEach(initCanvas);
      function initCanvas(canvasEl) {
        const scene = new THREE.Scene();
        const simScene = new THREE.Scene();
        const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0.1, 10);
        camera.position.z = 1;
        const renderer = new THREE.WebGLRenderer({
          canvas: canvasEl,
          antialias: true,
          alpha: true,
          preserveDrawingBuffer: true,
        });
        const mouse = new THREE.Vector2(0, 0);
        let frame = 0;
        let rtA, rtB;
        const options = {
          format: THREE.RGBAFormat,
          type: THREE.HalfFloatType,
          minFilter: THREE.LinearFilter,
          magFilter: THREE.LinearFilter,
          depthBuffer: false,
          stencilBuffer: false,
        };
        const loader = new THREE.TextureLoader();
        const imageTexture = loader.load(getImageUrl(canvasEl), function () {
          const bubbleImgs = document.querySelectorAll('.water-bubble-img');
          if (bubbleImgs.length) {
            bubbleImgs.forEach(function (bubbleImg) {
              bubbleImg.style.display = 'none';
            });
          }
        });
        imageTexture.minFilter = THREE.LinearFilter;
        imageTexture.magFilter = THREE.LinearFilter;
        imageTexture.wrapS = THREE.ClampToEdgeWrapping;
        imageTexture.wrapT = THREE.ClampToEdgeWrapping;
        const simMaterial = new THREE.ShaderMaterial({
          uniforms: {
            textureA: { value: null },
            mouse: { value: mouse },
            resolution: { value: new THREE.Vector2(1, 1) },
            time: { value: 0 },
            frame: { value: 0 },
          },
          vertexShader: `
        varying vec2 vUv;
        void main() {
          vUv = uv;
          gl_Position = vec4(position, 1.0);
        }
      `,
          fragmentShader: `
        uniform sampler2D textureA;
        uniform vec2 mouse;
        uniform vec2 resolution;
        uniform float time;
        uniform int frame;
        varying vec2 vUv;
        const float delta = 1.4;
        void main() {
          vec2 uv = vUv;
          if (frame == 0) {
            gl_FragColor = vec4(0.0);
            return;
          }
          vec4 data = texture2D(textureA, uv);
          float pressure = data.x;
          float pVel = data.y;
          vec2 texelSize = 1.0 / resolution;
          float p_right = texture2D(textureA, uv + vec2(texelSize.x, 0.0)).x;
          float p_left = texture2D(textureA, uv + vec2(-texelSize.x, 0.0)).x;
          float p_up = texture2D(textureA, uv + vec2(0.0, texelSize.y)).x;
          float p_down = texture2D(textureA, uv + vec2(0.0, -texelSize.y)).x;
          pVel += delta * (-2.0 * pressure + p_right + p_left) / 4.0;
          pVel += delta * (-2.0 * pressure + p_up + p_down) / 4.0;
          pressure += delta * pVel;
          pVel -= 0.005 * delta * pressure;
          pVel *= 1.0 - 0.002 * delta;
          pressure *= 0.96;
          vec2 mouseUV = mouse / resolution;
          if (mouse.x > 0.0 || mouse.y > 0.0) {
            float dist = distance(uv, mouseUV);
            if (dist <= 0.01) {
              pressure += 2.0 * (1.0 - dist / 0.02);
            }
          }
          gl_FragColor = vec4(
            pressure,
            pVel,
            (p_right - p_left) * 0.5,
            (p_up - p_down) * 0.5
          );
        }
      `,
        });
        const renderMaterial = new THREE.ShaderMaterial({
          uniforms: {
            textureA: { value: null },
            textureB: { value: imageTexture },
            uvScale: { value: 1 },
          },
          vertexShader: `
        varying vec2 vUv;
        void main() {
          vUv = uv;
          gl_Position = vec4(position, 1.0);
        }
      `,
          fragmentShader: `
        uniform sampler2D textureA;
        uniform sampler2D textureB;
        uniform float uvScale;
        varying vec2 vUv;
        void main() {
          vec4 data = texture2D(textureA, vUv);
          vec2 distortion = 0.12 * data.zw;
          vec2 uv = (vUv - 0.5) * uvScale + 0.5;
          gl_FragColor = texture2D(textureB, uv + distortion);
        }
      `,
          transparent: true,
        });
        const quadGeo = new THREE.PlaneGeometry(2, 2);
        simScene.add(new THREE.Mesh(quadGeo, simMaterial));
        scene.add(new THREE.Mesh(quadGeo, renderMaterial));
        function resize() {
          const rect = canvasEl.getBoundingClientRect();
          if (!rect.width || !rect.height) return;
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          renderer.setPixelRatio(dpr);
          renderer.setSize(rect.width, rect.height, false);
          const w = Math.max(1, Math.floor(rect.width * dpr));
          const h = Math.max(1, Math.floor(rect.height * dpr));
          simMaterial.uniforms.resolution.value.set(w, h);
          if (!rtA) {
            rtA = new THREE.WebGLRenderTarget(w, h, options);
            rtB = new THREE.WebGLRenderTarget(w, h, options);
          } else {
            rtA.setSize(w, h);
            rtB.setSize(w, h);
          }
        }
        function updateMouseFromEvent(e) {
          const rect = canvasEl.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          const dpr = renderer.getPixelRatio();
          mouse.x = x * dpr;
          mouse.y = (rect.height - y) * dpr;
        }
        canvasEl.addEventListener('mousemove', updateMouseFromEvent);
        canvasEl.addEventListener('mouseleave', function () {
          mouse.set(0, 0);
        });
        window.addEventListener('resize', resize);
        function animate() {
          if (!rtA || !rtB) {
            requestAnimationFrame(animate);
            return;
          }
          simMaterial.uniforms.frame.value = frame++;
          simMaterial.uniforms.time.value = performance.now() / 1000;
          simMaterial.uniforms.textureA.value = rtA.texture;
          renderer.setRenderTarget(rtB);
          renderer.render(simScene, camera);
          renderMaterial.uniforms.textureA.value = rtB.texture;
          renderer.setRenderTarget(null);
          renderer.render(scene, camera);
          const temp = rtA;
          rtA = rtB;
          rtB = temp;
          requestAnimationFrame(animate);
        }
        resize();
        animate();
      }
    }
    /* Do not add anything below this code */
  });
</script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script src="
https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/js/splide.min.js
"></script>
  <script src="
https://cdn.jsdelivr.net/npm/@splidejs/splide-extension-auto-scroll@0.5.3/dist/js/splide-extension-auto-scroll.min.js
"></script>
  <script>
  document.addEventListener('DOMContentLoaded', () => {
    /* Images Slider START */
    const imagesSlider = new Splide('#images-slider', {
      type: 'loop',
      drag: 'free',
      focus: 'center',
      arrows: false,
      pagination: false,
      gap: '0.875rem',
      perPage: 3,
      autoScroll: {
        speed: 0.5,
        pauseOnFocus: false,
        pauseOnHover: false,
      },
      breakpoints: {
        992: {
          perPage: 2,
        },
        767: {
          perPage: 1,
        },
      },
    });
    imagesSlider.mount(window.splide.Extensions);
    /* Images Slider END */
  });
</script>
</body>
</html>