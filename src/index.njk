https://cdn.jsdelivr.net/npm/@splidejs/splide-extension-auto-scroll@0.5.3/dist/js/splide-extension-auto-scroll.min.js
"></script>
  <script>
  document.addEventListener('DOMContentLoaded', () => {
    /* Partner Logos Slider START */
    const partnersSliderFirst = new Splide('#partners-slider-first', {
      type: 'loop',
      drag: 'free',
      focus: 'center',
      arrows: false,
      pagination: false,
      gap: '4rem',
      perPage: 8,
      autoScroll: {
        speed: 0.5,
      },
      breakpoints: {
        992: {
          perPage: 5,
          gap: '2rem',
        },
        767: {
          perPage: 4,
          gap: '1.5rem',
          autoScroll: {
            speed: 0.25,
          },
        },
      },
    });
    const partnersSliderSecond = new Splide('#partners-slider-second', {
      type: 'loop',
      drag: 'free',
      focus: 'center',
      arrows: false,
      pagination: false,
      gap: '4rem',
      perPage: 8,
      autoScroll: {
        speed: -0.5,
      },
      breakpoints: {
        992: {
          perPage: 5,
          gap: '2rem',
        },
        767: {
          perPage: 4,
          gap: '1.5rem',
          autoScroll: {
            speed: -0.25,
          },
        },
      },
    });
    partnersSliderFirst.mount(window.splide.Extensions);
    partnersSliderSecond.mount(window.splide.Extensions);
    /* Partner Logos Slider END */
    /* Experts Slider START */
    const expertsSlider = new Splide('#experts-slider', {
      type: 'loop',
      drag: 'free',
      focus: 'center',
      arrows: false,
