---
permalink: sitemap.xml
eleventyExcludeFromCollections: true
---
{#- Every page except 404 and pages marked `noindex: true`. Case studies and insights are listed from the CMS data. -#}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for item in collections.all %}{% if not item.data.noindex %}
  <url><loc>{{ siteUrl }}{{ "/" if item.url == "/" else item.url | replace(".html", "") }}</loc></url>
{%- endif %}{% endfor %}
{%- for cs in caseStudies | published %}
  <url><loc>{{ siteUrl }}/case-study/{{ cs.slug }}</loc></url>
{%- endfor %}
{%- for insight in insights | published %}
  <url><loc>{{ siteUrl }}/insights/{{ insight.slug }}</loc></url>
{%- endfor %}
</urlset>
