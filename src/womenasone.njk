            textureA: { value: null },
            textureB: { value: imageTexture },
            uvScale: { value: 1 },
          },
          vertexShader: `
        varying vec2 vUv;
        void main() {
          vUv = uv;
          gl_Position = vec4(position, 1.0);
        }
      `,
          fragmentShader: `
        uniform sampler2D textureA;
        uniform sampler2D textureB;
        uniform float uvScale;
        varying vec2 vUv;
        void main() {
          vec4 data = texture2D(textureA, vUv);
          vec2 distortion = 0.12 * data.zw;
          vec2 uv = (vUv - 0.5) * uvScale + 0.5;
          gl_FragColor = texture2D(textureB, uv + distortion);
        }
      `,
          transparent: true,
        });
        const quadGeo = new THREE.PlaneGeometry(2, 2);
        simScene.add(new THREE.Mesh(quadGeo, simMaterial));
        scene.add(new THREE.Mesh(quadGeo, renderMaterial));
        function resize() {
          const rect = canvasEl.getBoundingClientRect();
          if (!rect.width || !rect.height) return;
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          renderer.setPixelRatio(dpr);
          renderer.setSize(rect.width, rect.height, false);
          const w = Math.max(1, Math.floor(rect.width * dpr));
          const h = Math.max(1, Math.floor(rect.height * dpr));
          simMaterial.uniforms.resolution.value.set(w, h);
          if (!rtA) {
            rtA = new THREE.WebGLRenderTarget(w, h, options);
            rtB = new THREE.WebGLRenderTarget(w, h, options);
          } else {
            rtA.setSize(w, h);
            rtB.setSize(w, h);
          }
        }
        function updateMouseFromEvent(e) {
          const rect = canvasEl.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          const dpr = renderer.getPixelRatio();
          mouse.x = x * dpr;
          mouse.y = (rect.height - y) * dpr;
        }
        canvasEl.addEventListener('mousemove', updateMouseFromEvent);
        canvasEl.addEventListener('mouseleave', function () {
          mouse.set(0, 0);
        });
        window.addEventListener('resize', resize);
        function animate() {
          if (!rtA || !rtB) {
            requestAnimationFrame(animate);
            return;
          }
          simMaterial.uniforms.frame.value = frame++;
          simMaterial.uniforms.time.value = performance.now() / 1000;
          simMaterial.uniforms.textureA.value = rtA.texture;
          renderer.setRenderTarget(rtB);
          renderer.render(simScene, camera);
          renderMaterial.uniforms.textureA.value = rtB.texture;
          renderer.setRenderTarget(null);
          renderer.render(scene, camera);
          const temp = rtA;
          rtA = rtB;
          rtB = temp;
          requestAnimationFrame(animate);
        }
        resize();
        animate();
      }
    }
    /* Do not add anything below this code */
  });
</script>
